# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dronecup
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/dronecup_test

# Server
PORT=3001
NODE_ENV=development

# Admin authentication — required for mutation endpoints (start match, submit/correct results)
# Replace with a strong random string in production
ADMIN_SECRET=replace-with-a-strong-secret

# CORS origin — set to the frontend URL in production (e.g. https://yourdomain.com)
# Use * for development or when backend serves the frontend on the same origin
CORS_ORIGIN=http://localhost:5173
